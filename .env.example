# Optional: leave blank to create the admin account via the one-time /setup wizard on first visit instead.
# If set here, generate independent random values, e.g. openssl rand -hex 32.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
EXPORT_TOKEN=
COUNTRIES=in,us
CATEGORIES=
EPG_URLS=
SYNC_ON_START=true
SCHEDULER_ENABLED=true
HEALTH_INTERVAL_HOURS=6
CHECK_TIMEOUT=5
CHECK_CONCURRENCY=20
# Set these for docker compose --profile tls up -d --build
DOMAIN=pilot.example.com
ACME_EMAIL=
CF_DNS_API_TOKEN=
